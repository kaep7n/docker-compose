{
  "id": null,
  "uid": "tempo-dotnet-starter",
  "title": "Tempo + .NET Starter",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["tempo", "dotnet", "opentelemetry"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "current": { "selected": true }
      },
      {
        "type": "datasource",
        "name": "DS_TEMPO",
        "query": "tempo",
        "current": { "selected": true }
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
        "query": "label_values(traces_spanmetrics_calls_total, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      },
      {
        "type": "query",
        "name": "operation",
        "label": "Operation",
        "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
        "query": "label_values(traces_spanmetrics_calls_total{service=~\"$service\"}, span_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "RED metrics (from traces)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Requests/s (RPS)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (%)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "targets": [
        {
          "expr": "100 * sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", status_code!=\"STATUS_CODE_OK\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "Error %"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg latency (ms)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "targets": [
        {
          "expr": "1000 * sum(rate(traces_spanmetrics_latency_sum{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_latency_count{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency quantiles (ms, P50/P95/P99)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "options": { "legend": { "displayMode": "list" } },
      "exemplars": { "display": true }
    },
    {
      "type": "table",
      "title": "Top slow operations (P95, ms)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "$DS_PROMETHEUS" },
      "targets": [
        {
          "expr": "topk(10, 1000 * histogram_quantile(0.95, sum by (span_name, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))))",
          "legendFormat": "{{span_name}}"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": {}, "indexByName": {}, "renameByName": { "Value": "p95_ms" } } }
      ]
    },
    {
      "type": "row",
      "title": "Trace drilldowns (Tempo / TraceQL)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },
    {
      "type": "traces",
      "title": "Recent slow traces",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "tempo", "uid": "$DS_TEMPO" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" } | duration > 100ms | error = true | order by duration desc | limit 50"
        }
      ]
    },
    {
      "type": "traces",
      "title": "Recent traces by operation",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "tempo", "uid": "$DS_TEMPO" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\", name =~ \"$operation\" } | order by start_time desc | limit 50"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      { "builtIn": 1, "type": "dashboard", "name": "Annotations & Alerts", "hide": true, "enable": true }
    ]
  },
  "links": []
}
